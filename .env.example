# Copia este archivo a `.env` y rellena tus credenciales.
# Solo variables con prefijo VITE_ se exponen al cliente (Vite).

# Supabase — Project URL sin /rest/v1/
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Supabase — anon key (JWT eyJ...) o publishable key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=

# TMDB — API Read Access Token (v3 auth)
VITE_TMDB_API_KEY=

# Opcional — identificador de build para logs de auditoría
VITE_APP_BUILD=local-dev
